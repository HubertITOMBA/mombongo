# Copier dans .env.local pour une configuration manuelle. Ne jamais committer les secrets.
DATABASE_URL="postgresql://facturia:CHANGE_ME@127.0.0.1:5433/facturia?schema=public"
# Générer une valeur aléatoire d’au moins 32 caractères.
AUTH_SECRET=
# Origine publique. En local : localhost. En production : https://mombongo.fr
APP_URL="http://localhost:9070"
# Doit correspondre à l’origine ouverte dans le navigateur (Origin / NextAuth).
AUTH_URL="http://localhost:9070"
# local : uniquement en développement ; resend : obligatoire en production.
MAIL_TRANSPORT="local"
LOCAL_MAIL_DIR="/chemin/absolu/vers-le-depot/.local/mail"
RESEND_API_KEY=
# Expéditeur Resend autorisé (domaine configuré). Pas d’adresse inventée dans le code.
EMAIL_FROM=
# true seulement derrière un proxy de confiance qui écrase X-Real-IP.
AUTH_TRUST_PROXY="false"
# A14 : aucun secret de plateforme agréée. Le provider MOCK n’en exige pas.
