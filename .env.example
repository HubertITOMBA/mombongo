# Développement local uniquement. Copier vers .env à la racine (Prisma CLI).
DATABASE_URL="postgresql://facturia:facturia_local@localhost:5432/facturia?schema=public"
POSTGRES_USER=facturia
POSTGRES_PASSWORD=facturia_local
POSTGRES_DB=facturia
# Secrets : les renseigner dans .env / apps/web/.env.local, jamais ici.
AUTH_SECRET=
RESEND_API_KEY=
# Expéditeur Resend autorisé, ex. une adresse du domaine configuré. Jamais codé en dur.
EMAIL_FROM=
